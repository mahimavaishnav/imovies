# Server port
PORT=5000

# MongoDB Atlas connection string (replace <user>, <password>, <cluster>)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# Token expiry
JWT_EXPIRES_IN=7d

# Allowed frontend origin (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173
